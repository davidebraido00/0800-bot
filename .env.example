# Copia in .env e compila. NON committare .env.

# callmebot (gratis, consigliato per uso personale) oppure twilio
WHATSAPP_PROVIDER=callmebot

# Il tuo numero in formato internazionale, es. +393331234567
WHATSAPP_TO=

# Link iCal privato di Google Calendar (più calendari separati da virgola).
# Vuoto = sezione agenda saltata.
GOOGLE_CALENDAR_ICS=

# --- Email via Gmail ---
# Indirizzo Gmail da cui inviare e destinatario (se vuoto = lo stesso indirizzo)
EMAIL_FROM=
EMAIL_TO=
# Password per le app di Google (16 lettere), NON la password dell'account. Vedi README.
EMAIL_APP_PASSWORD=

# --- CallMeBot ---
CALLMEBOT_APIKEY=

# --- Twilio (solo se WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+14155238886
